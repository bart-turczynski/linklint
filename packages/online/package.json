{
  "name": "@linklint/online",
  "version": "0.1.0-dev.0",
  "description": "Explicit Node/server online capabilities for linklint.",
  "keywords": ["url", "security", "linklint", "resolution", "reputation"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./resolution": {
      "types": "./dist/resolution/index.d.ts",
      "default": "./dist/resolution/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "linklint": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
