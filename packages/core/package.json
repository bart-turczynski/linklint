{
  "name": "linklint",
  "version": "0.1.0-dev.0",
  "description": "Explainable, offline-first URL inspector — detects deceptive links (homographs, confusables, userinfo spoofs, IP obfuscation) with named reason codes and no network.",
  "keywords": [
    "url",
    "security",
    "phishing",
    "homograph",
    "confusable",
    "punycode",
    "idn",
    "url-inspection",
    "offline"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/bart-turczynski/linklint.git",
    "directory": "packages/core"
  },
  "homepage": "https://gitlab.com/bart-turczynski/linklint#readme",
  "bugs": {
    "url": "https://gitlab.com/bart-turczynski/linklint/-/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "default": "./dist/experimental.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "tldts": "^7.4.10",
    "tr46": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
