{
  "name": "linklint",
  "version": "0.1.0-dev.0",
  "description": "Explainable, offline-first URL inspector — detects deceptive links (homographs, confusables, userinfo spoofs, IP obfuscation) with named reason codes and no network.",
  "keywords": [
    "url",
    "security",
    "phishing",
    "homograph",
    "confusable",
    "punycode",
    "idn",
    "url-inspection",
    "offline"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "tldts": "^7.0.0",
    "tr46": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
