{
  "name": "linklint-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "features": "cucumber-js",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "data:confusables": "node tools/build-confusables.mjs",
    "data:ip-ranges": "node tools/build-ip-ranges.mjs",
    "data:boundary": "tsx packages/core/test/boundary-baseline.ts",
    "data:upstream-check": "tsx tools/check-upstream.ts",
    "data:nsp": "tsx packages/core/test/nsp-experiment.ts",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm features"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
