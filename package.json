{
  "name": "linklint-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "features": "cucumber-js",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "data:confusables": "node tools/build-confusables.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm features"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
